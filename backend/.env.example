# Copy to backend/.env and fill in a private Gemini API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=20
GEMINI_MAX_PROMPT_CHARS=24000
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_MAX_TOTAL_OUTPUT_TOKENS=2048
QUERY_EMBEDDING_CACHE_TTL_SECONDS=3600
CAREBRIDGE_PROMPT_VERSION=v3
AI_RATE_LIMIT_PER_MINUTE=60

# Optional: set current provider rates to show estimated USD/query in the chat.
# Values are USD per million tokens; leave unset until verified for your account/model.
# GEMINI_INPUT_USD_PER_MILLION_TOKENS=
# GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=
# GEMINI_EMBEDDING_USD_PER_MILLION_TOKENS=
