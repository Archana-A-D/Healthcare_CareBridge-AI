# Optional root Compose overrides. Copy to .env and replace every secret.
MYSQL_DATABASE=carebridge
MYSQL_USER=carebridge
MYSQL_PASSWORD=replace-this-local-password
MYSQL_ROOT_PASSWORD=replace-this-root-password
DJANGO_SECRET_KEY=replace-this-django-secret
CELERY_CONCURRENCY=2
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
AI_RATE_LIMIT_PER_MINUTE=60
